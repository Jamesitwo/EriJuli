# ============================================================
#  EriJuli · variables de entorno
#  En local: copia este archivo como .env  ·  En Railway: Variables del servicio
# ============================================================

# --- Obligatorias en producción ---------------------------------
# Clave larga y aleatoria (mínimo 32 caracteres). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
NODE_ENV=production

# --- Base de datos ------------------------------------------------
# En Railway no hace falta si montas un Volume: la app usa /data/app.db automáticamente.
# DATABASE_PATH=/data/app.db

# --- Dirección pública ---------------------------------------------
# En Railway se detecta sola (RAILWAY_PUBLIC_DOMAIN). Ponla si usas un dominio propio.
# APP_URL=https://erijuli.up.railway.app

# --- Puerto (Railway lo asigna solo) ------------------------------
# PORT=3000

# --- Correo para recuperar la contraseña (opcional) ---------------
# Con Gmail usa una "contraseña de aplicación". Sin SMTP el enlace se escribe en los registros del servidor.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASS=contraseña-de-aplicacion
# MAIL_FROM="EriJuli <tucorreo@gmail.com>"

# --- Notificaciones en el celular (opcional) ----------------------
# Si no las pones, la app crea unas y las guarda en la base de datos.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tucorreo@gmail.com

# --- Lectura de Gmail (opcional, ver README) -----------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Carpetas (opcional; por defecto junto a la base de datos) ----
# UPLOADS_PATH=/data/uploads
# BACKUP_DIR=/data/backups
