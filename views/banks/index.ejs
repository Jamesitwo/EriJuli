<% const currency = user.currency; %>
<div class="hero hero-sm">
  <div class="hero-label">Total general (cuentas, bolsillos y efectivo)</div>
  <div class="hero-amount"><%= formatMoney(total, currency) %></div>
</div>

<% banks.forEach(function (b) { %>
  <section class="card">
    <div class="card-head">
      <h2><% if (b.kind === 'efectivo') { %><svg class="ic ic-sm cash-ic"><use href="#i-cash"/></svg><% } else { %><span class="dot" style="background:<%= b.color %>"></span><% } %> <%= b.name %><% if (b.kind === 'efectivo') { %> <span class="badge badge-success">Sin banco</span><% } %></h2>
      <strong><%= formatMoney(b.total, currency) %></strong>
    </div>
    <div class="stack">
      <% b.containers.forEach(function (c) { %>
        <div class="bank-row">
          <span class="tx-icon <%= c.kind === 'cuenta' ? '' : 'pocket' %>"><%= c.kind === 'cuenta' ? '' : '' %></span>
          <span class="bank-name"><%= c.name %><small class="muted"><%= c.purpose || (b.kind === 'efectivo' ? 'Efectivo' : c.kind === 'cuenta' ? 'Dinero sin propósito' : 'Bolsillo') %><%= c.last4 ? ' · *' + c.last4 : '' %></small></span>
          <strong><%= formatMoney(c.balance, currency) %></strong>
        </div>
      <% }) %>
    </div>
    <a class="btn btn-ghost btn-block mt-1" href="/bancos/<%= b.id %>"><%= b.kind === 'efectivo' ? 'Administrar efectivo' : 'Administrar ' + b.name %></a>
  </section>
<% }) %>

<section class="card">
  <h2>Agregar banco</h2>
  <form method="post" action="/bancos" class="filter-grid">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="bank-name">Nombre</label>
      <input id="bank-name" name="name" required placeholder="Ej. Bancolombia">
    </div>
    <div class="field">
      <label for="bank-color">Color</label>
      <input id="bank-color" name="color" type="color" value="#0f5c45">
    </div>
    <div class="filter-actions">
      <button class="btn btn-primary" type="submit">Agregar</button>
    </div>
  </form>
  <p class="muted">Las tarjetas de crédito tienen su propia sección y se muestran como deuda: <a href="/tarjetas">Tarjetas</a>.</p>
</section>

<% if (!hasCash) { %>
<section class="card">
  <h2><svg class="ic ic-sm cash-ic"><use href="#i-cash"/></svg> Efectivo</h2>
  <p class="muted">Lleva la cuenta de los billetes que tienes en la mano o guardados en casa, sin que pertenezcan a ningún banco. Suma al total general y puedes mover dinero entre el efectivo y tus cuentas (retiros y consignaciones).</p>
  <form method="post" action="/efectivo">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn btn-primary btn-block" type="submit">Agregar efectivo</button>
  </form>
</section>
<% } %>

<section class="card">
  <h2>Mover dinero</h2>
  <p class="muted">Entre cuenta, bolsillos y bancos. Deja registro y <strong>no</strong> cuenta como ingreso ni gasto.</p>
  <form method="post" action="/transferencias" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="back" value="/bancos">
    <div class="field">
      <label for="t-from">De</label>
      <select id="t-from" name="container_from_id" required>
        <% allContainers.forEach(function (c) { %>
          <option value="<%= c.id %>"><%= c.bank_name %> · <%= c.name %> (<%= formatMoney(c.balance, currency) %>)</option>
        <% }) %>
      </select>
    </div>
    <div class="field">
      <label for="t-to">A</label>
      <select id="t-to" name="container_to_id" required>
        <% allContainers.forEach(function (c, i) { %>
          <option value="<%= c.id %>" <%= i === 1 ? 'selected' : '' %>><%= c.bank_name %> · <%= c.name %></option>
        <% }) %>
      </select>
    </div>
    <div class="field-row">
      <div class="field">
        <label for="t-amount">Valor</label>
        <input id="t-amount" name="amount" inputmode="decimal" required placeholder="0">
      </div>
      <div class="field">
        <label for="t-date">Fecha</label>
        <input id="t-date" name="date" type="date" value="<%= dates.todayISO() %>">
      </div>
    </div>
    <div class="field">
      <label for="t-desc">Descripción</label>
      <input id="t-desc" name="description" placeholder="Ej. Separar para la moto">
    </div>
    <button class="btn btn-primary btn-block" type="submit">Mover dinero</button>
  </form>
</section>
