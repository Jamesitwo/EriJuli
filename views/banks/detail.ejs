<% const currency = user.currency; const isCash = bank.kind === 'efectivo'; %>
<div class="hero hero-sm">
  <div class="hero-label"><%= isCash ? 'Total en efectivo' : 'Total en ' + bank.name %></div>
  <div class="hero-amount"><%= formatMoney(total, currency) %></div>
  <a class="btn btn-ghost btn-sm" href="/bancos">← Volver a bancos</a>
</div>

<!-- Bolsillos y cuenta -->
<% containers.forEach(function (c) { %>
  <section class="card">
    <div class="card-head">
      <h2><%= c.kind === 'cuenta' ? '' : '' %> <%= c.name %></h2>
      <strong><%= formatMoney(c.balance, currency) %></strong>
    </div>
    <% if (c.purpose) { %><p class="muted"><%= c.purpose %></p><% } %>
    <details>
      <summary class="link">Editar</summary>
      <form method="post" action="/bolsillos/<%= c.id %>/editar" class="stack mt-1">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label>Nombre</label>
          <input name="name" value="<%= c.name %>" required>
        </div>
        <div class="field">
          <label>Propósito</label>
          <input name="purpose" value="<%= c.purpose || '' %>" placeholder="Ej. Papeles de la moto 2027">
        </div>
        <% if (!isCash && c.kind === 'cuenta') { %>
        <div class="field">
          <label>Últimos 4 dígitos de la cuenta</label>
          <input name="last4" inputmode="numeric" maxlength="4" pattern="[0-9]{4}" value="<%= c.last4 || '' %>" placeholder="Ej. 7890">
          <small class="muted">Sirve para reconocer esta cuenta en los correos del banco (ej. "*7890").</small>
        </div>
        <% } else { %><input type="hidden" name="last4" value="<%= c.last4 || '' %>"><% } %>
        <div class="field">
          <label>Saldo inicial (antes de los movimientos)</label>
          <input name="initial_balance" inputmode="decimal" value="<%= (c.initial_balance / 100).toString().replace('.', ',') %>">
        </div>
        <label class="check"><input type="checkbox" name="archived" <%= c.archived ? 'checked' : '' %>> Archivar (ocultar sin borrar)</label>
        <button class="btn btn-primary" type="submit">Guardar</button>
      </form>
    </details>
  </section>
<% }) %>

<!-- Agregar bolsillo -->
<section class="card">
  <h2><%= isCash ? 'Agregar lugar de efectivo' : 'Agregar bolsillo' %></h2>
  <% if (isCash) { %><p class="muted">Por ejemplo "Caja en casa" o "Alcancía". Cada lugar lleva su propio saldo.</p><% } %>
  <form method="post" action="/bancos/<%= bank.id %>/bolsillos" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="p-name">Nombre</label>
      <input id="p-name" name="name" required placeholder="<%= isCash ? 'Ej. Caja en casa' : 'Ej. Fondo de emergencia' %>">
    </div>
    <div class="field">
      <label for="p-purpose">Propósito</label>
      <input id="p-purpose" name="purpose" placeholder="¿Para qué es este bolsillo?">
    </div>
    <div class="field">
      <label for="p-initial">Saldo inicial</label>
      <input id="p-initial" name="initial_balance" inputmode="decimal" placeholder="0">
    </div>
    <button class="btn btn-primary" type="submit"><%= isCash ? 'Agregar' : 'Crear bolsillo' %></button>
  </form>
</section>

<!-- Mover dinero -->
<section class="card">
  <h2><%= isCash ? 'Consignar o retirar' : 'Mover dinero desde este banco' %></h2>
  <form method="post" action="/transferencias" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="back" value="/bancos/<%= bank.id %>">
    <div class="field">
      <label for="t-from">De</label>
      <select id="t-from" name="container_from_id" required>
        <% allContainers.forEach(function (c) { %>
          <option value="<%= c.id %>" <%= c.bank_id === bank.id ? 'selected' : '' %>><%= c.bank_name %> · <%= c.name %> (<%= formatMoney(c.balance, currency) %>)</option>
        <% }) %>
      </select>
    </div>
    <div class="field">
      <label for="t-to">A</label>
      <select id="t-to" name="container_to_id" required>
        <% allContainers.forEach(function (c) { %>
          <option value="<%= c.id %>"><%= c.bank_name %> · <%= c.name %></option>
        <% }) %>
      </select>
    </div>
    <div class="field">
      <label for="t-amount">Valor</label>
      <input id="t-amount" name="amount" inputmode="decimal" required placeholder="0">
    </div>
    <div class="field">
      <label for="t-desc">Descripción</label>
      <input id="t-desc" name="description" placeholder="Ej. Separar para la moto">
    </div>
    <button class="btn btn-primary btn-block" type="submit">Mover dinero</button>
  </form>
</section>
