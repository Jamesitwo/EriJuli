<% const currency = user.currency; %>
<section class="card">
  <h2>Bandeja de revisión</h2>
  <div class="alert <%= gmail.connected ? 'alert-info' : 'alert-warning' %>">
    <span><%= gmail.message %></span>
  </div>
  <p class="muted">
    Aquí llegan los <strong>movimientos propuestos</strong> detectados en tus correos de banco.
    Nada afecta tus saldos hasta que los aceptes, edites o descartes.
  </p>

  <% if (gmail.connected) { %>
    <!-- Sincronizar -->
    <form method="post" action="/gmail/sincronizar" class="filter-grid mt-1">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="sync-days">Leer correos de los últimos</label>
        <select id="sync-days" name="dias">
          <option value="7">7 días</option>
          <option value="30" selected>30 días</option>
          <option value="90">90 días</option>
          <option value="365">1 año</option>
        </select>
      </div>
      <div class="filter-actions">
        <button class="btn btn-primary" type="submit">Sincronizar ahora</button>
      </div>
    </form>

    <!-- Remitentes autorizados -->
    <details class="mt-1">
      <summary class="link">Remitentes autorizados (<%= senders.length %>)</summary>
      <p class="muted mt-1">La app SOLO lee correos de los remitentes que autorizas aquí (ej. los avisos de tu banco). Puedes poner un correo exacto o un dominio completo: Bancolombia envía desde varias direcciones (<code>an.</code>, <code>ayn.</code>), así que es mejor autorizar <code>notificacionesbancolombia.com</code>.</p>
      <% if (!senders.some(function (s) { return /notificacionesbancolombia/.test(s.sender); })) { %>
      <form method="post" action="/gmail/remitentes" class="mt-1">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="sender" value="notificacionesbancolombia.com">
        <input type="hidden" name="label" value="Alertas Bancolombia">
        <% const bcol = banks.find(function (b) { return /bancolombia/i.test(b.name); }); %>
        <% if (bcol) { %><input type="hidden" name="bank_id" value="<%= bcol.id %>"><% } %>
        <button class="btn btn-ghost btn-sm" type="submit"><svg class="ic ic-sm"><use href="#i-plus"/></svg> Autorizar alertas de Bancolombia</button>
      </form>
      <% } %>
      <div class="stack mt-1">
        <% senders.forEach(function (s) { %>
          <div class="flex-between">
            <span><%= s.sender %> <small class="muted"><%= s.label || s.bank_name || '' %></small></span>
            <form method="post" action="/gmail/remitentes/<%= s.id %>/eliminar">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-ghost btn-sm" type="submit">Quitar</button>
            </form>
          </div>
        <% }) %>
      </div>
      <form method="post" action="/gmail/remitentes" class="filter-grid mt-1">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label for="sender">Correo o dominio del remitente</label>
          <input id="sender" name="sender" type="text" inputmode="email" autocapitalize="off" spellcheck="false" required placeholder="notificacionesbancolombia.com">
        </div>
        <div class="field">
          <label for="sender-label">Descripción</label>
          <input id="sender-label" name="label" placeholder="Ej. Avisos Bancolombia">
        </div>
        <div class="field">
          <label for="sender-bank">Banco</label>
          <select id="sender-bank" name="bank_id">
            <option value="">Sin banco</option>
            <% banks.forEach(function (b) { %>
              <option value="<%= b.id %>"><%= b.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="filter-actions">
          <button class="btn btn-primary" type="submit">Autorizar remitente</button>
        </div>
      </form>
    </details>

    <!-- Desconectar -->
    <details class="mt-1">
      <summary class="link">Desconectar Gmail</summary>
      <form method="post" action="/gmail/desconectar" class="stack mt-1">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="check">
          <input type="checkbox" name="borrar_propuestas">
          Borrar también las propuestas importadas y las reglas aprendidas
        </label>
        <button class="btn btn-danger" type="submit"
          onclick="return confirm('Se revocará el acceso de la app a tu Gmail. ¿Continuar?');">Desconectar y revocar acceso</button>
      </form>
    </details>
  <% } else { %>
    <form method="get" action="/gmail/conectar" class="stack mt-1 consent-note">
      <p class="muted">Antes de conectar, ten presente:</p>
      <ul class="muted">
        <li>Solo se pide permiso de <strong>lectura</strong>; la app no envía, borra ni cambia correos.</li>
        <li>Solo se leen los remitentes que autorices (las alertas de tu banco).</li>
        <li>Los datos no se venden, no se comparten y no se usan para publicidad.</li>
        <li>Puedes desconectar y borrar lo importado cuando quieras.</li>
      </ul>
      <label class="check">
        <input type="checkbox" name="acepto" value="1" required>
        <span>Autorizo leer los correos de mi banco según la <a href="/privacidad" target="_blank" rel="noopener">política de privacidad</a>.</span>
      </label>
      <button class="btn btn-primary btn-block" type="submit">Conectar Gmail (solo lectura)</button>
    </form>
    <details class="mt-1">
      <summary class="link">¿Cómo funciona y qué datos se usan?</summary>
      <ol class="mt-1 muted">
        <li>La app pide permiso de <strong>solo lectura</strong> (nunca tu contraseña).</li>
        <li>Leerá únicamente los correos de los remitentes que autorices.</li>
        <li>Solo se guardan los datos extraídos (valor, fecha, comercio), nunca el cuerpo del correo.</li>
        <li>Puedes desconectar Gmail y borrar lo importado cuando quieras.</li>
      </ol>
      <p class="muted">Si aún no está configurado en el servidor, registra los movimientos a mano o impórtalos por CSV.</p>
    </details>
  <% } %>
</section>

<% if (!items.length) { %>
  <section class="card">
    <p class="muted">No hay movimientos esperando revisión. </p>
  </section>
<% } %>

<% const senderName = function (v) { const m = /^\s*"?([^"<]+?)"?\s*</.exec(v || ''); return m ? m[1].trim() : String(v || '').replace(/^.*@/, ''); }; %>
<% items.forEach(function (p) { %>
  <section class="proposal">
    <div class="proposal-head">
      <span style="display:flex;gap:6px;align-items:center"><svg class="ic ic-sm"><use href="#i-mail"/></svg><span class="proposal-from"><%= p.status === 'sin_procesar' ? 'Sin procesar' : 'Propuesto' %><%= p.email_sender ? ' · ' + senderName(p.email_sender) : '' %></span></span>
      <% if (p.email_link) { %><a href="<%= p.email_link %>" target="_blank" rel="noopener">Ver correo</a><% } %>
    </div>
    <div class="proposal-body">
    <div class="card-head" style="margin:0">
      <h2><%= p.description || 'Movimiento detectado' %></h2>
      <strong class="tx-amount <%= p.kind %>"><%= p.kind === 'ingreso' ? '+ ' : p.kind === 'gasto' ? '− ' : '' %><%= formatMoney(p.amount, currency) %></strong>
    </div>
    <p class="muted">
      <%= dates.formatDate(p.date) %>
      <% if (p.email_subject) { %> · "<%= p.email_subject %>"<% } %>
      <% if (p.status === 'sin_procesar') { %> · <span class="badge badge-warning">sin procesar</span><% } %>
    </p>
    <% if (p.reason) { %><p class="muted"><small><%= p.reason %></small></p><% } %>
    <form method="post" action="/bandeja/<%= p.id %>/aceptar" class="stack proposal-form" data-kind="<%= p.kind %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field-row">
        <div class="field">
          <label>Tipo</label>
          <select name="kind">
            <option value="gasto" <%= p.kind === 'gasto' ? 'selected' : '' %>>Gasto</option>
            <option value="ingreso" <%= p.kind === 'ingreso' ? 'selected' : '' %>>Ingreso</option>
            <option value="transferencia" <%= p.kind === 'transferencia' ? 'selected' : '' %>>Movimiento</option>
          </select>
        </div>
        <div class="field">
          <label>Valor</label>
          <input name="amount" inputmode="decimal" value="<%= (p.amount / 100).toString().replace('.', ',') %>">
        </div>
      </div>
      <div class="field">
        <label>Descripción</label>
        <input name="description" value="<%= p.description || '' %>">
      </div>
      <div class="field">
        <label>Categoría</label>
        <select name="category_id">
          <option value="">Sin categoría</option>
          <% categories.forEach(function (c) { %>
            <option value="<%= c.id %>" <%= p.category_id === c.id ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="field" data-for="gasto transferencia">
        <label>De dónde salió</label>
        <select name="container_from_id">
          <option value="">Elegir…</option>
          <% containers.forEach(function (c) { %>
            <option value="<%= c.id %>" <%= p.container_from_id === c.id ? 'selected' : '' %>><%= c.bank_name %> · <%= c.name %><%= c.last4 ? ' *' + c.last4 : '' %></option>
          <% }) %>
          <% if (cards.length) { %><optgroup label="Tarjetas de crédito">
            <% cards.forEach(function (k) { %>
              <option value="tarjeta:<%= k.id %>" <%= p.card_id === k.id ? 'selected' : '' %>><%= k.name %><%= k.last4 ? ' *' + k.last4 : '' %></option>
            <% }) %>
          </optgroup><% } %>
        </select>
      </div>
      <div class="field" data-for="ingreso transferencia">
        <label>A dónde entró</label>
        <select name="container_to_id">
          <option value="">Elegir…</option>
          <% containers.forEach(function (c) { %>
            <option value="<%= c.id %>" <%= p.container_to_id === c.id ? 'selected' : '' %>><%= c.bank_name %> · <%= c.name %><%= c.last4 ? ' *' + c.last4 : '' %></option>
          <% }) %>
        </select>
      </div>
      <label class="check">
        <input type="checkbox" name="learn_rule" checked>
        Recordar esta decisión para la próxima vez (misma categoría y cuenta)
      </label>
      <div class="flex-between">
        <button class="btn btn-primary btn-block" type="submit">Aceptar y registrar</button>
      </div>
    </form>
    <form method="post" action="/bandeja/<%= p.id %>/descartar" onsubmit="return confirm('¿Descartar esta propuesta? No afectará tus saldos.');">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-danger btn-block" type="submit">Descartar</button>
    </form>
  </div>
  </section>
<% }) %>

<!-- Agregar propuesta manual -->
<section class="card">
  <h2>Registrar movimiento detectado a mano</h2>
  <p class="muted">Para correos que la app no pudo interpretar o para cargar propuestas tú mismo.</p>
  <form method="post" action="/bandeja" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field-row">
      <div class="field">
        <label>Tipo</label>
        <select name="kind">
          <option value="gasto">Gasto</option>
          <option value="ingreso">Ingreso</option>
          <option value="transferencia">Movimiento</option>
        </select>
      </div>
      <div class="field">
        <label>Valor</label>
        <input name="amount" inputmode="decimal" required placeholder="0">
      </div>
    </div>
    <div class="field-row">
      <div class="field">
        <label>Fecha</label>
        <input type="date" name="date" value="<%= dates.todayISO() %>">
      </div>
      <div class="field">
        <label>Descripción</label>
        <input name="description" placeholder="Ej. Compra Éxito">
      </div>
    </div>
    <div class="field-row">
      <div class="field">
        <label>Remitente del correo</label>
        <input name="email_sender" placeholder="Ej. alertas@bancolombia.com">
      </div>
      <div class="field">
        <label>Asunto</label>
        <input name="email_subject">
      </div>
    </div>
    <div class="field">
      <label>Enlace al correo (opcional)</label>
      <input name="email_link" placeholder="https://mail.google.com/…">
    </div>
    <button class="btn btn-primary btn-block" type="submit">Agregar a la bandeja</button>
  </form>
</section>
