<% const hasPin = !!user.pin_hash; %>
<!-- Contraseña -->
<section class="card">
  <h2>Contraseña</h2>
  <form method="post" action="/seguridad/contrasena" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="current">Contraseña actual</label>
      <input id="current" type="password" name="current" required autocomplete="current-password">
    </div>
    <div class="field-row">
      <div class="field">
        <label for="password">Nueva (mínimo 8)</label>
        <input id="password" type="password" name="password" required minlength="8" autocomplete="new-password">
      </div>
      <div class="field">
        <label for="password2">Repite la nueva</label>
        <input id="password2" type="password" name="password2" required minlength="8" autocomplete="new-password">
      </div>
    </div>
    <button class="btn btn-ghost" type="submit">Cambiar contraseña</button>
  </form>
</section>

<!-- Códigos de recuperación -->
<section class="card" id="codigos">
  <h2>Códigos de recuperación</h2>
  <% if (codes) { %>
    <div class="alert alert-warning"><span>Guárdalos ahora en un lugar seguro (una foto, tu gestor de contraseñas o papel). No los volverás a ver.</span></div>
    <ol class="codes mt-1">
      <% codes.forEach(function (c) { %><li><code><%= c %></code></li><% }) %>
    </ol>
    <button class="btn btn-ghost btn-sm mt-1" type="button" data-copy="<%= codes.join('\n') %>">Copiar códigos</button>
  <% } else { %>
    <p class="muted">Si olvidas tu contraseña y no te llega el correo, un código te deja entrar. Cada uno sirve una sola vez.</p>
    <p class="mt-1"><span class="badge <%= codesLeft ? 'badge-success' : 'badge-warning' %>"><%= codesLeft ? `Te quedan ${codesLeft} códigos` : 'Aún no tienes códigos' %></span></p>
  <% } %>
  <form method="post" action="/seguridad/codigos" class="mt-1" <% if (codesLeft) { %>data-confirm="Se crearán códigos nuevos y los anteriores dejarán de funcionar."<% } %>>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn btn-ghost btn-block" type="submit"><%= codesLeft ? 'Crear códigos nuevos' : 'Crear mis códigos' %></button>
  </form>
</section>

<!-- Bloqueo de la app -->
<section class="card">
  <h2>Bloqueo con PIN y huella</h2>
  <p class="muted">Si alguien toma tu celular con la sesión abierta, no podrá ver tu dinero sin el PIN, tu huella o Face ID.</p>
  <% if (hasPin) { %>
    <p class="mt-1"><span class="badge badge-success">Bloqueo activo · después de <%= user.lock_minutes %> <%= user.lock_minutes === 1 ? 'minuto' : 'minutos' %> sin uso</span></p>
    <form method="post" action="/seguridad/bloqueo" class="filter-grid mt-1">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="lock_minutes">Bloquear después de</label>
        <select id="lock_minutes" name="lock_minutes">
          <% [[1,'1 minuto'],[5,'5 minutos'],[15,'15 minutos'],[60,'1 hora']].forEach(function (o) { %>
            <option value="<%= o[0] %>" <%= user.lock_minutes === o[0] ? 'selected' : '' %>><%= o[1] %></option>
          <% }) %>
        </select>
      </div>
      <div class="filter-actions"><button class="btn btn-ghost" type="submit">Guardar</button></div>
    </form>

    <h3 class="mt-1">Huella o Face ID</h3>
    <% if (devices.length) { %>
      <div class="stack" style="gap:0">
        <% devices.forEach(function (d) { %>
          <div class="tx-row">
            <span class="tx-icon"><svg class="ic"><use href="#i-finger"/></svg></span>
            <span class="tx-info"><strong><%= d.label %></strong><small class="muted">Agregado <%= dates.formatDate(String(d.created_at).slice(0, 10)) %></small></span>
            <form method="post" action="/seguridad/huella/<%= d.id %>/eliminar" data-confirm="¿Quitar este dispositivo? Ya no podrás desbloquear con su huella.">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-danger btn-sm" type="submit">Quitar</button>
            </form>
          </div>
        <% }) %>
      </div>
    <% } %>
    <button class="btn btn-ghost btn-block mt-1" type="button" id="add-biometric" hidden>
      <svg class="ic ic-sm"><use href="#i-finger"/></svg> Usar la huella o Face ID de este dispositivo
    </button>
    <p class="muted mt-1" id="biometric-unsupported" hidden>Este navegador no permite usar la huella aquí. Funciona en la app instalada o en Chrome/Safari con HTTPS.</p>

    <details class="mt-1">
      <summary class="link">Cambiar o quitar el PIN</summary>
      <form method="post" action="/seguridad/pin" class="stack mt-1">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="lock_minutes" value="<%= user.lock_minutes %>">
        <div class="field-row">
          <div class="field"><label>PIN nuevo</label><input name="pin" type="password" inputmode="numeric" pattern="\d{4,6}" maxlength="6" autocomplete="off"></div>
          <div class="field"><label>Repite el PIN</label><input name="pin2" type="password" inputmode="numeric" pattern="\d{4,6}" maxlength="6" autocomplete="off"></div>
        </div>
        <div class="toolbar">
          <button class="btn btn-ghost" type="submit">Cambiar PIN</button>
          <button class="btn btn-danger" type="submit" name="quitar" value="1" formnovalidate data-confirm="¿Quitar el bloqueo? También se quitarán las huellas registradas.">Quitar bloqueo</button>
        </div>
      </form>
    </details>
  <% } else { %>
    <form method="post" action="/seguridad/pin" class="stack mt-1">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field-row">
        <div class="field"><label for="pin">PIN (4 a 6 números)</label><input id="pin" name="pin" type="password" inputmode="numeric" pattern="\d{4,6}" maxlength="6" required autocomplete="off"></div>
        <div class="field"><label for="pin2">Repite el PIN</label><input id="pin2" name="pin2" type="password" inputmode="numeric" pattern="\d{4,6}" maxlength="6" required autocomplete="off"></div>
      </div>
      <div class="field">
        <label for="lock_minutes">Bloquear después de</label>
        <select id="lock_minutes" name="lock_minutes">
          <option value="1">1 minuto</option><option value="5" selected>5 minutos</option><option value="15">15 minutos</option><option value="60">1 hora</option>
        </select>
      </div>
      <button class="btn btn-primary btn-block" type="submit">Activar bloqueo</button>
      <small class="muted">Después podrás agregar tu huella o Face ID.</small>
    </form>
  <% } %>
</section>

<!-- Notificaciones -->
<section class="card" id="notificaciones">
  <h2>Notificaciones en el celular</h2>
  <p class="muted">Te avisamos de gastos fijos por vencer, pagos de tarjeta, topes de categoría y saldo bajo, aunque no tengas la app abierta. Solo entre 7 a. m. y 9 p. m.</p>
  <p class="mt-1"><span class="badge" id="push-status"><%= pushDevices ? `Activas en ${pushDevices} ${pushDevices === 1 ? 'dispositivo' : 'dispositivos'}` : 'Desactivadas' %></span></p>
  <div class="toolbar mt-1" id="push-actions" data-key="<%= vapidKey %>">
    <button class="btn btn-primary" type="button" id="push-on">Activar en este dispositivo</button>
    <button class="btn btn-ghost" type="button" id="push-test" <%= pushDevices ? '' : 'hidden' %>>Enviar prueba</button>
    <button class="btn btn-danger" type="button" id="push-off" hidden>Desactivar aquí</button>
  </div>
  <p class="muted mt-1" id="push-help" hidden></p>
</section>
<script src="/js/seguridad.js?v=7" defer></script>
