<% const currency = user.currency; %>
<div class="toolbar">
  <a class="btn btn-primary" href="#crear-meta">＋ Nueva meta</a>
</div>

<% if (!goals.length) { %>
  <section class="card">
    <p class="muted">Aún no tienes metas. Crea una para saber cuánto aportar por periodo (ej. "Papeles de la moto 2027").</p>
  </section>
<% } %>

<% goals.forEach(function (g) { %>
  <section class="card">
    <div class="card-head">
      <h2><%= g.name %></h2>
      <strong><%= g.pct %>%</strong>
    </div>
    <div class="progress">
      <div class="progress-bar <%= g.pct >= 100 ? '' : '' %>" style="width: <%= g.pct %>%"></div>
    </div>
    <div class="flex-between muted">
      <span><%= formatMoney(g.saved, currency) %> de <%= formatMoney(g.target_amount, currency) %></span>
      <% if (g.target_date) { %>
        <span>meta: <%= dates.formatDate(g.target_date) %></span>
      <% } %>
    </div>
    <div class="summary-grid mt-1">
      <div><small class="muted">Bolsillo</small><div><strong><%= g.container_name || 'Sin asignar' %></strong></div></div>
      <div><small class="muted">Aporte sugerido</small><div><strong><%= formatMoney(g.suggested, currency) %></strong> <%= g.monthsLeft !== null ? '/ mes (' + g.monthsLeft + ' meses)' : '' %></div></div>
      <div><small class="muted">Falta</small><div><strong><%= formatMoney(Math.max(0, g.target_amount - g.saved), currency) %></strong></div></div>
    </div>

    <% if (!g.container_id) { %>
      <div class="alert alert-warning mt-1"><span>Esta meta no tiene bolsillo. El dinero de una meta se guarda en un bolsillo; sin él no hay dónde aportar.</span></div>
      <form method="post" action="/metas/<%= g.id %>/bolsillo" class="filter-grid mt-1">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label>Bolsillo para esta meta</label>
          <select name="container_id" required>
            <% banks.forEach(function (b, i) { %><option value="nuevo:<%= b.id %>" <%= i === 0 ? 'selected' : '' %>>Crear bolsillo "<%= g.name %>" en <%= b.name %></option><% }) %>
            <% containers.filter(function (c) { return c.kind === 'bolsillo'; }).forEach(function (c) { %><option value="<%= c.id %>">Usar <%= c.bank_name %> · <%= c.name %></option><% }) %>
          </select>
        </div>
        <div class="filter-actions"><button class="btn btn-primary" type="submit">Asociar bolsillo</button></div>
      </form>
    <% } else { const sources = containers.filter(function (c) { return c.id !== g.container_id; }); const withMoney = sources.filter(function (c) { return c.balance > 0; }); %>
    <details class="mt-1">
      <summary class="link">Aportar ahora</summary>
      <% if (!withMoney.length) { %>
        <p class="muted mt-1">No tienes saldo en otras cuentas o bolsillos para aportar. <a href="/movimientos/nuevo?kind=ingreso">Registra primero un ingreso</a>.</p>
      <% } else { %>
      <form method="post" action="/metas/<%= g.id %>/aportar" class="stack mt-1 goal-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <p class="muted">El dinero se mueve de la cuenta que elijas al bolsillo <strong style="color:var(--ink)"><%= g.container_name %></strong>. No es un gasto.</p>
        <div class="field">
          <label for="gf-<%= g.id %>">De dónde sale el dinero</label>
          <select id="gf-<%= g.id %>" name="container_from_id" required data-picker class="goal-from">
            <option value="">Elige cuenta o bolsillo…</option>
            <% withMoney.forEach(function (c) { %>
              <option value="<%= c.id %>" data-name="<%= c.name %>" data-bank="<%= c.bank_name %>" data-kind="<%= c.kind %>" data-raw="<%= c.balance %>" data-balance="<%= formatMoney(c.balance, currency) %>"><%= c.bank_name %> · <%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="field-row">
          <div class="field">
            <label>Valor</label>
            <input name="amount" inputmode="decimal" required placeholder="0" class="goal-amount" value="<%= g.suggested > 0 ? Math.min(g.suggested, Math.max(0, g.target_amount - g.saved)) / 100 : '' %>">
          </div>
          <div class="field">
            <label>Fecha</label>
            <input type="date" name="date" value="<%= dates.todayISO() %>">
          </div>
        </div>
        <p class="ej-hint goal-hint" aria-live="polite"></p>
        <button class="btn btn-primary btn-sm goal-submit" type="submit">Aportar a la meta</button>
      </form>
      <% } %>
    </details>
    <% } %>

    <details class="mt-1">
      <summary class="link">Editar meta</summary>
      <form method="post" action="/metas/<%= g.id %>/editar" class="stack mt-1">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label>Nombre</label>
          <input name="name" value="<%= g.name %>">
        </div>
        <div class="field-row">
          <div class="field">
            <label>Monto objetivo</label>
            <input name="target_amount" inputmode="decimal" value="<%= (g.target_amount / 100).toString().replace('.', ',') %>">
          </div>
          <div class="field">
            <label>Fecha objetivo</label>
            <input type="date" name="target_date" value="<%= g.target_date || '' %>">
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label>Bolsillo asociado</label>
            <select name="container_id">
              <option value="">Sin asignar</option>
              <% containers.forEach(function (c) { %>
                <option value="<%= c.id %>" <%= g.container_id === c.id ? 'selected' : '' %>><%= c.bank_name %> · <%= c.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="field">
            <label>Aporte por periodo</label>
            <input name="contribution_per_period" inputmode="decimal" value="<%= (g.contribution_per_period / 100).toString().replace('.', ',') %>">
          </div>
        </div>
        <label class="check"><input type="checkbox" name="archived" <%= g.archived ? 'checked' : '' %>> Archivar meta</label>
        <button class="btn btn-primary btn-sm" type="submit">Guardar</button>
      </form>
    </details>
  </section>
<% }) %>

<!-- Crear meta -->
<section class="card" id="crear-meta">
  <h2>Nueva meta de ahorro</h2>
  <form method="post" action="/metas" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="g-name">Nombre</label>
      <input id="g-name" name="name" required placeholder="Ej. Papeles de la moto 2027">
    </div>
    <div class="field-row">
      <div class="field">
        <label for="g-target">Monto objetivo</label>
        <input id="g-target" name="target_amount" inputmode="decimal" required placeholder="0">
      </div>
      <div class="field">
        <label for="g-date">Fecha objetivo</label>
        <input id="g-date" name="target_date" type="date">
      </div>
    </div>
    <div class="field-row">
      <div class="field">
        <label for="g-container">Bolsillo asociado</label>
        <select id="g-container" name="container_id">
          <% banks.forEach(function (b, i) { %><option value="nuevo:<%= b.id %>" <%= i === 0 ? 'selected' : '' %>>Crear un bolsillo nuevo en <%= b.name %></option><% }) %>
          <% containers.filter(function (c) { return c.kind === 'bolsillo'; }).forEach(function (c) { %>
            <option value="<%= c.id %>">Usar <%= c.bank_name %> · <%= c.name %></option>
          <% }) %>
          <option value="">Sin bolsillo por ahora</option>
        </select>
        <small class="muted">Recomendado: un bolsillo propio, así lo ahorrado no se mezcla.</small>
      </div>
      <div class="field">
        <label for="g-contrib">Aporte sugerido por periodo</label>
        <input id="g-contrib" name="contribution_per_period" inputmode="decimal" placeholder="0">
      </div>
    </div>
    <button class="btn btn-primary btn-block" type="submit">Crear meta</button>
  </form>
</section>
<script>
  // Aviso de saldo en el aporte y bloqueo si no alcanza
  document.querySelectorAll('.goal-form').forEach(function (f) {
    var sel = f.querySelector('.goal-from'), amt = f.querySelector('.goal-amount'), hint = f.querySelector('.goal-hint'), btn = f.querySelector('.goal-submit');
    var parse = function (v) { return Number(String(v || '').replace(/\./g, '').replace(',', '.')) || 0; };
    var fmt = function (n) { return '$' + Math.round(n).toLocaleString('es-CO'); };
    function check() {
      var o = sel.selectedOptions[0], a = parse(amt.value);
      if (!o || !o.value) { hint.textContent = ''; btn.disabled = false; return; }
      var bal = Number(o.dataset.raw) / 100, left = bal - a;
      hint.className = 'ej-hint goal-hint' + (left < 0 ? ' neg' : '');
      hint.textContent = left < 0 ? 'No alcanza: en ' + o.dataset.name + ' hay ' + fmt(bal) : 'Disponible ' + fmt(bal) + (a > 0 ? ' · quedarían ' + fmt(left) : '');
      btn.disabled = left < 0;
    }
    sel.addEventListener('change', check); amt.addEventListener('input', check); check();
  });
</script>
