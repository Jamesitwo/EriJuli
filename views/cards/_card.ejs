<% const s = c.status; const pct = Math.min(100, Math.max(0, s.used)); %>
<a class="ccard" href="/tarjetas/<%= c.id %>" style="--cc:<%= c.color %>">
  <div class="ccard-top">
    <div>
      <div class="ccard-name"><%= c.name %></div>
      <small class="muted"><%= [c.bank_name, c.last4 ? '•••• ' + c.last4 : ''].filter(Boolean).join(' · ') %></small>
    </div>
    <% if (s.overdue) { %><span class="badge badge-danger">Pago vencido</span>
    <% } else if (s.toPay > 0 && s.daysToDue <= 5) { %><span class="badge badge-warning">Paga en <%= s.daysToDue === 0 ? 'hoy' : s.daysToDue + (s.daysToDue === 1 ? ' día' : ' días') %></span>
    <% } else if (s.toPay === 0 && s.debt <= 0) { %><span class="badge badge-success">Al día</span><% } %>
  </div>
  <div class="ccard-row">
    <div><small class="muted">Debes</small><div class="pocket-amount"><%= formatMoney(Math.max(0, s.debt), currency) %></div></div>
    <div class="right"><small class="muted">Disponible</small><div class="num"><strong><%= formatMoney(s.available, currency) %></strong></div></div>
  </div>
  <% if (c.credit_limit > 0) { %>
    <div class="progress progress-sm" role="img" aria-label="Usas <%= pct %>% del cupo"><div class="progress-bar <%= pct >= 90 ? 'danger' : pct >= 70 ? 'warning' : '' %>" style="width:<%= pct %>%"></div></div>
    <small class="muted">Usas <%= s.used %>% de <%= formatMoney(c.credit_limit, currency) %></small>
  <% } %>
  <div class="ccard-foot">
    <% if (s.toPay > 0) { %>
      <span>Pagar <strong class="num"><%= formatMoney(s.toPay, currency) %></strong> <%= s.daysToDue < 0 ? 'desde el' : 'antes del' %> <%= dates.formatDate(s.due, { year: false }) %></span>
    <% } else if (s.sinceCut > 0) { %>
      <span>Próximo pago: <strong class="num"><%= formatMoney(s.sinceCut, currency) %></strong> antes del <%= dates.formatDate(s.nextDue, { year: false }) %></span>
    <% } else { %>
      <span>Sin pagos pendientes</span>
    <% } %>
    <span class="muted">Corte <%= dates.formatDate(s.nextCut, { year: false }) %></span>
  </div>
</a>
